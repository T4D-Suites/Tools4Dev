_t4dSrcJksFileInit(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcJksFileInit
#   - Name:
#       _t4dSrcJksFileInit
###
#   - Synopsis:
#       allow user to create jenkinsfile dynamically
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Template="$WS_ROOT/_Jenkins_/.Jenkinsfile.base"
    local _Vars="JENKINS_LIB_VERSION PROJECT_NAME GIT_REPOSITORY JENKINS_NOTIFICATION_LVL IRC_CHANNEL CI_SCENARIO"
    local _ProjectName=""
    local _Repo=""
    local _LibVersion=""
    local _NotificationLvl="1"
    local _Irc="sandbox"
    local _Scheme="default"
    local _Bool="default"
    local _Target="default"
    local _outputFile="$WS_ROOT/_Jenkins_/Jenkinsfile"
     while [[ "$@" != "" ]]; do
        case "$1" in
            -input)
                shift
                _Template="$1"
            ;;
            -suffix)
                shift
                _outputFile="$_outputFile.$1"
            ;;
            -define|-D)
                shift
                _Vars="$_Vars $1"
            ;;
            -lib-version|-V)
                shift
                _LibVersion="main@release/$1"
            ;;
            -param|-P)
                shift
                _Bool="$_Bool $1"
            ;;
            -target|-T)
                shift
                _Target=" $_Target $1"
            ;;
            *)
                _t4dDebugLog $perror "Empty or Unknown argument < $1 >"
                return $_t4dErrorCode
            ;;
        esac
        shift
    done

    if [[ ! -e "$_Template" ]]; then
        _Template="$Tools4Dev_PATH/Templates/jenkinsFile.in"
    fi

###############################
}