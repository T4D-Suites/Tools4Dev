
_t4dSrcjenkinsHtmlGetSessionCookie(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcjenkinsHtmlGetSessionCookie
#   - Name:
#       _t4dSrcjenkinsHtmlGetSessionCookie
###
#   - Synopsis:
#       get session cookie and crumb id
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _url="$1"
    local _user="$2"
    local _password="$3"
    local _cookiePath="./.cookies-jks"

    local _crumb="$(curl -s --cookie-jar $_cookiePath -u $_user:$_password http://$_url/crumbIssuer/api/json | grep -Eo "crumb.*" | cut -d":" -f2 | cut -d'"' -f2)"

    local _cookie="$(cat $_cookiePath)"

    echo "$_crumb|$_cookie"

    rm $_cookiePath

###############################
}