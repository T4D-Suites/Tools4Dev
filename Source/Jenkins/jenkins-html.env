
_t4dSrcjenkinsHtmlGetSessionCookie(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcjenkinsHtmlGetSessionCookie
#   - Name:
#       _t4dSrcjenkinsHtmlGetSessionCookie
###
#   - Synopsis:
#       get session cookie and crumb id
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _url="$1"
    local _user="$2"
    local _password="$3"
    local _cookiePath="./.cookies-jks"

    local _crumb="$(curl -s --cookie-jar $_cookiePath -u $_user:$_password http://$_url/crumbIssuer/api/json | grep -Eo "crumb.*" | cut -d":" -f2 | cut -d'"' -f2)"

    local _cookie="$(cat $_cookiePath)"

    echo "$_crumb|$_cookie"

    rm $_cookiePath

###############################
}

_t4dSrcjenkinsHtmlGetSpan(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcjenkinsHtmlGetSpan
#   - Name:
#       _t4dSrcjenkinsHtmlGetSpan
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _File="$1"
    local _Search="$2"
    cat $_File | tr '\n' '±' | sed "s|</span>|<Closure>\n|g"  | grep "$_Search" | tr '±' '\n' | tr '>' '\n' | grep -v "<span" | grep -v "<Closure" | tr -d '^$' | sed 's|&gt;|>|g'
    

###############################
}

_t4dSrcjenkinsHtmlGetBlock(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcjenkinsHtmlGetBlock
#   - Name:
#       _t4dSrcjenkinsHtmlGetBlock
###
#   - Synopsis:
