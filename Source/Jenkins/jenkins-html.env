###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _File="$1"
    local _Search="$2"
    local _Balise="${3:-span}"
    local _Values="$(cat $_File  | sed 's|</|\n|g' | grep -Eo '<div.*' | grep "$_Search" | rev  | cut -d '>' -f1 | rev)"

    echo $_Values    
###############################
}

