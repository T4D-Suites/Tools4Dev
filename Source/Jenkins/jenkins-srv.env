_t4dSrcJenkinsSrvExec(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcJenkinsSrvExec
#   - Name:
#       _t4dSrcJenkinsSrvExec
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Server="$(echo $1| sed 's|http.*//||g' | cut -d ':' -f1)"
    local _User="$2"
    local _Command="${@:4}"
    local _Tools4DevPath="${3}"
    # _t4dDebugLog $plog "$_Command"
    _t4dSrcFileSystemSshT4dOutput ${_User}@${_Server} ${_Tools4DevPath} ${_Command}

###############################
}

_t4dSrcJenkinsSrvGetConfigFile(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcJenkinsSrvGetConfigFile
#   - Name:
#       _t4dSrcJenkinsSrvGetConfigFile
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Path="$1"
    if [[ -e "$_Path/config.xml" ]]; then
        cat $_Path/config.xml
    else
        echo ""
    fi

###############################
}

_t4dSrcJenkinsSrvCheckAccess(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcJenkinsSrvCheckAccess
#   - Name:
#       _t4dSrcJenkinsSrvCheckAccess
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    # local _t4dErrorCode=1
    local _Server="$2"
    local _User="$1"
    local _Output="$(_t4dSrcJenkinsSrvExec $_Server $_User "echo true")"
    if [[ "$_Output" == "true" ]]; then
        return 0
    else
        _t4dDebugLog $perror "can't connect to $_Server using $_User"
    fi

###############################
}

_t4dSrcJenkinsSrvSearchConfigFiles(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcJenkinsSrvSearchConfigFiles
#   - Name:
#       _t4dSrcJenkinsSrvSearchConfigFiles
###
#   - Synopsis:
#       List all configs of given jenkins path file except branches
###
#   - Usage:
#       _t4dSrcJenkinsSrvSearchConfigFiles <JenkinsRoot> [RelativePath]
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _RootPath="${1:-/var/lib/jenkins}"
    local _RelativePath="${2}"
    if [[ "$_RelativePath" == "" ]]; then
        _t4dDebugLog $pwarning "Default path selected, might take a while to search all config files"
    fi

    if [[ -e "${_RootPath}/config.xml" ]]; then
        find $_RootPath/jobs/${_RelativePath} -name 'config.xml' ! -path '*/branches/*' | sort -n
    else
        _t4dDebugLog $perror "_t4dSrcJenkinsSrvSearchConfigFiles - Could not find Jenkins config file >${_RootPath}/config.xml<"
        return $_t4dErrorCode
    fi
    

###############################
}
