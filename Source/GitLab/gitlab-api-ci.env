_t4dGitLabProjectPipelinesAPIStart(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dGitLabProjectPipelinesAPIStart
#   - Name:
#       _t4dGitLabProjectPipelinesAPIStart
###
#   - Synopsis:
#       Write jobs from pipeline to json file
###
#   - Usage:
#       * _t4dGitLabProjectPipelinesAPIStart <Project> <InputJsonFile> <OutputJsonFile>
#
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########

    local _project="$(echo ${1} | sed 's|/|%2F|g')"
    (curl -X POST -v "https://$_t4dGitLabURL/api/v4/projects/${_project}/pipeline?private_token=${GITLAB_TOKEN}" -H "Content-Type: application/json" -d "$(cat ${2} )" 2> "$T4D_PROJECT_LOG_PATH/gitlab/curl.log" | _t4dConvertToJson "${3}") || echo "${plred}ERROR 251${pstd} in _t4dGitLabProjectPipelinesAPIStart : is Arg Number ($#) == 3 ? | args <$@>"

###############################
}

