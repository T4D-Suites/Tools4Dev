_t4dGitLabProjectPipelinesAPIList(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dGitLabProjectPipelinesAPIList
#   - Name:
#       _t4dGitLabProjectPipelinesAPIList
###
#   - Synopsis:
#       Write Pipeline List to json file
###
#   - Usage:
#       * _t4dGitLabProjectPipelinesAPIList <Project> <JsonFile> [Branch]
#
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########

    local _project="$(echo ${1} | sed 's|/|%2F|g')"
    local _suppl=""
    if [[ "${3:-null}" != "null" ]]; then _suppl="&ref=${3}"; fi
    (curl -s "https://$_t4dGitLabURL/api/v4/projects/${_project}/pipelines?private_token=${GITLAB_TOKEN}${suppl}" | _t4dConvertToJson "${2}") || echo "${plred}ERROR 251${pstd} in _t4dGitLabMergeRequestAPIList : is Arg Number ($#) == 2 ? | args <$@>"

###############################
}

_t4dGitLabProjectPipelinesAPILatest(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dGitLabProjectPipelinesAPILatest
#   - Name:
#       _t4dGitLabProjectPipelinesAPILatest
###
#   - Synopsis:
#       Write latest Pipeline to json file
###
#   - Usage:
#       * _t4dGitLabProjectPipelinesAPILatest <Project> <JsonFile> <Branch>
#
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########

    local _project="$(echo ${1} | sed 's|/|%2F|g')"
    (curl -s "https://$_t4dGitLabURL/api/v4/projects/${_project}/pipelines/latest?ref=${3}&private_token=${GITLAB_TOKEN}" | _t4dConvertToJson "${2}") || echo "${plred}ERROR 251${pstd} in _t4dGitLabMergeRequestAPIList : is Arg Number ($#) == 2 ? | args <$@>"

###############################
}
