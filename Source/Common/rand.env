_t4dSrcRandString(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcRandString
#   - Name:
#       _t4dSrcRandString
###
#   - Synopsis:
#       get list of strings and shuffle between each values in each args seperate by spaces
###
#   - Usage:
#       _t4dSrcRandString {list} [integer] [file]
###
#   - Examples:
#       * _t4dSrcRandString test.txt
#       * _t4dSrcRandString "namea" "+" 100
#       * _t4dSrcRandString "namea nameb namec" "+" "100" "@" "myorg" "." "com io fr" | tr '[:upper:]' '[:lower:]'
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Res=""
    for _item in $@; do
        local _list="$_item"
        if [[ -f "$_item" ]]; then
            _list="$(cat $_list)"
        fi
        _Res="${_Res}$(_t4dSrcRandFromList $_list)"
    done

    echo "$_Res"
     
###############################
}

_t4dSrcRandFromList(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcRandFromList
#   - Name:
#       _t4dSrcRandFromList
###
#   - Synopsis:
#       return a random output from given list
###
#   - Examples:
#       * _t4dSrcRandFromList "$(seq 1 10)" 
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _List=$@
    if [[ $# -eq 0 ]]; then
        _List=$(seq 1 100)
    elif [[ "$(echo $1 | grep -Eo '^[0-9]+$' | head -1)" == "$1" ]]; then
        _List=$(seq 1 $1)
    fi
    echo $_List | tr ' ' '\n' | shuf | head -1

###############################
}
