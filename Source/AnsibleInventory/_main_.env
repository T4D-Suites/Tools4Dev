_t4dSrcAnsibleInventoryAddHost(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryAddHost
#   - Name:
#       _t4dSrcAnsibleInventoryAddHost
###
#   - Synopsis:
#       add host in Ansible Inventory
###
#   - Usage:
#        _t4dSrcYalmUpdateLine <group> <host> <file>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Group="$1"
    local _Host="$2"
    local _Path="$2"

    if [[ "$_Group" == "" ]]; then
        _t4dDebugLog $perror "empty Group"
        return $_t4dErrorCode
    fi
    if [[ "$_Host" == "" ]]; then
        _t4dDebugLog $perror "empty Host"
        return $_t4dErrorCode
    fi
        if [[ "$_Path" == "" ]]; then
        _t4dDebugLog $perror "empty file"
        return $_t4dErrorCode
    fi

    local _res=$(sed "s|\(.*$(echo $_Group).*\)|\1\n$(echo $_Host)|g" "$_Path")
    echo "$_res" > "$_Path"

###############################
}