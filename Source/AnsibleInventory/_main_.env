_t4dSrcAnsibleInventoryAddHost(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryAddHost
#   - Name:
#       _t4dSrcAnsibleInventoryAddHost
###
#   - Synopsis:
#       add host in Ansible Inventory
###
#   - Usage:
#        _t4dSrcAnsibleInventoryAddHost <group> <host> <file>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Group="$1"
    local _Host="$2"
    local _Path="$3"

    if [[ "$_Group" == "" ]]; then
        _t4dDebugLog $perror "empty Group"
        return $_t4dErrorCode
    fi
    if [[ "$_Host" == "" ]]; then
        _t4dDebugLog $perror "empty Host"
        return $_t4dErrorCode
    fi
    if [[ "$_Path" == "" ]]; then
        _t4dDebugLog $perror "empty file"
        return $_t4dErrorCode
    fi

    if [[ "$_t4dSrcAnsibleInventoryHostAlreadyInGroup $_Group $_Host $_Path" == "true" ]]; then
        _t4dDebugLog $perror "host already in this group"
        return $_t4dErrorCode
    fi

    if [[ "$_t4dSrcAnsibleInventoryGroupExist $_Group $_Path" == "true" ]]; then
        echo "\n[$_Group]" >> "$_Path"
    fi

    local _res=$(sed "s|\(.*$(echo $_Group).*\)|\1\n$(echo $_Host)|g" "$_Path")
    echo "$_res" > "$_Path"

###############################
}

_t4dSrcAnsibleInventoryGroupExist(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryAddHost
#   - Name:
#       _t4dSrcAnsibleInventoryAddHost
###
#   - Synopsis:
#       ckeck if host group exist
###
#   - Usage:
#        _t4dSrcAnsibleInventoryGroupExist <group> <file>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Group="$1"
    local _File="$2"

    if [[ "$_Group" == "" ]]; then
        _t4dDebugLog $perror "empty Group"
        return $_t4dErrorCode
    fi
    if [[ "$_File" == "" ]]; then
        _t4dDebugLog $perror "empty file"
        return $_t4dErrorCode

    local _groups=$(grep -e '^\[' $_File)

    if [[ "$(echo "$_groups" | grep "$_Group")" != "" ]]; then
        echo "true"
    else
        echo "false"
    fi

###############################
}

_t4dSrcAnsibleInventoryHostAlreadyInGroup(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryHostAlreadyInGroup
#   - Name:
#       _t4dSrcAnsibleInventoryHostAlreadyInGroup
###
#   - Synopsis:
#       check is host is already in group
###
#   - Usage:
#        _t4dSrcAnsibleInventoryHostAlreadyInGroup <group> <host> <file>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Group="$1"
    local _host="$2"
    local _File="$3"

    if [[ "$_Group" == "" ]]; then
        _t4dDebugLog $perror "empty Group"
        return $_t4dErrorCode
    fi
    if [[ "$_Host" == "" ]]; then
        _t4dDebugLog $perror "empty Host"
        return $_t4dErrorCode
    fi
        if [[ "$_File" == "" ]]; then
        _t4dDebugLog $perror "empty file"
        return $_t4dErrorCode
    fi

    local _HostInGroup=$(cat $_File | grep -A 1000 "$_Group" | grep -v "$_Group" | grep -m1 -B 1000 "^\[" | grep -v "^\["| sed '/^$/d')

    if [[ "$(grep "$_Host" "$_HostInGroup")"  != "" ]];then
        echo "true"
    else
        echo "false"
    fi

###############################
}