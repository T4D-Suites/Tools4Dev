_t4dMath(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dMath
#   - Name:
#       _t4dMath
###
#   - Synopsis:
#       Get line in manifest xml file or in input
###
#   - Usage:
#       * _t4dMath <calc> [-d|decimal x]
#
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Calc=""
    local _Decimal="0"


    while [[ "$@" != "" ]]; do
        case "$1" in
            -d|-decimal)
                _Decimal="$2"
                shift
            ;;
            *)
               _Calc="$_Calc $1"
            ;;
        esac
        shift
    done

    echo "scale=$_Decimal;$_Calc" |  bc



###############################
}