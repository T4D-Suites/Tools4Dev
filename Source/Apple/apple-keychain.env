_t4dSrcAppleKeychainList(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcAppleKeychainList
#   - Name:
#       _t4dSrcAppleKeychainList
###
#   - Synopsis:
#       return keychains that are available
###
#   - Usage
#       _t4dSrcAppleKeychainList [-path] [filter]
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Keychains="$(security list-keychain)"
    if [[ "$1" == "-path" ]]; then
        echo $_Keychains | tr -d ' ' | tr -d '"' | grep "$2"
    else
        echo $_Keychains | rev | cut -d '/' -f1 | cut -d '.' -f2 |rev | tr -d '"'  | grep "$1"
    fi
     

###############################
}

_t4dSrcAppleKeychainGetPassword(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcAppleKeychainGetPassword
#   - Name:
#       _t4dSrcAppleKeychainGetPassword
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Keychain="$(security default-keychain | tr -d ' ' | tr -d '"')"
    local _Name=""
    local _Type=""
    while [[ "$@" != "" ]]; do
        case "$1" in
            -keychain)
                _Keychain="$2"
                shift
            ;;
            -type)

                _Type="$2"
                shift
            ;;
            *)
                _Name="$1"
            ;;
        esac
        shift
    done
    if [[ "$(echo $_Keychain | grep "^/")" == "" ]]; then
        _Keychain="$(_t4dSrcAppleKeychainList -path $_Keychain)"
    fi

    if [[ "$_Type" != "" ]] && [[ "$_Type" != "password" ]]; then
        _TypeArg="-C $_Type"
    fi

    if [[ "$_Name" != "" ]]; then
        if [[ "$_Type" == "" ]]; then
            local _Dump="$(security find-generic-password -s "$_Name" "$_Keychain" 2> /dev/null )"
            if [[ "$(security find-generic-password -s "$_Name" "$_Keychain" 2> /dev/null)" == "" ]]; then
                return $_t4dErrorCode
            fi
            local _Type="$(security find-generic-password -s "$_Name" "$_Keychain" | grep '"type"' | grep -v "NULL" | rev | cut -d '"' -f2 | rev)"
        fi
        
        case $_Type in
            note)
                local _Var="$(security find-generic-password -s "$_Name" -w "$_Keychain"  | xxd -revert -plain)"
                if [[ "$_Var" == "" ]]; then
                    security find-generic-password -s "$_Name" -w "$_Keychain"
                elif [[ "$(echo $_Var | grep '^<?xml')" != "" ]]; then
                    security find-generic-password -s "$_Name" -w "$_Keychain"  | xxd -revert -plain | yq --input-format xml --prettyPrint '.plist.dict.string'
                else
                    echo $_Var
                fi
            ;;
            *)
                security find-generic-password -s "$_Name" -w "$_Keychain"
            ;;
        esac
        
    else
        security dump-keychain  "$_Keychain" | grep 'svce' | cut -d '"' -f4
    fi
    

###############################
}

_t4dSrcAppleKeychainSetPassword(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcAppleKeychainSetPassword
#   - Name:
#       _t4dSrcAppleKeychainSetPassword
###
#   - Synopsis:
#       description
###
#   - Usage:
#       _t4dSrcAppleKeychainSetPassword -name <varName> [-keychain {Keychain}] <data1> [data2] ..
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Keychain="$(security default-keychain | tr -d ' ' | tr -d '"')"
    local _KeyVarName=""
    local _Arg=""
    local _Type=""
    local _DryRun="true"
    while [[ "$@" != "" ]]; do
        case "$1" in
            -keychain)
                _Keychain="$2"
                shift
            ;;
            -name)
                _KeyVarName="$2"
                shift
            ;;
            -f)
                _DryRun="false"
            ;;
            *)
                _Arg="${_Arg}${1}\n"
                if [[ "$_Type" == "" ]]; then
                    _Type="password"
                else
                    _Type="note"
                fi
            ;; 
        esac
        shift
    done

    if [[ "$(echo $_Keychain | grep "^/")" == "" ]]; then
        _Keychain="$(_t4dSrcAppleKeychainList -path $_Keychain)"
    fi

    if [[ "${_KeyVarName}" == "" ]]; then
        _t4dDebugLog $perror "Name >${_KeyVarName}< is mandatory but seems empty"
        return $_t4dErrorCode 
    fi
    local _Current="$(_t4dSrcAppleKeychainGetPassword -type "$_Type" -keychain "$_Keychain" "$_KeyVarName")"
    if [[ "$_DryRun" == "false" ]]; then
        security add-generic-password -U -C $_Type -s $_KeyVarName -a $USER -w "$(echo $_Arg | sort -n)" "$_Keychain" &&
        if [[ "$_Current" != "" ]]; then
             _t4dCheckInfo "Keychain $_KeyVarName Updated"
        else
             _t4dCheckSucceeded "Keychain $_KeyVarName Created"
        fi
    else
        if [[  "$_Current" != "$(echo $_Arg | sort -n)" ]]; then
            _t4dPromptObjectCenter "$(_t4dPromptSquare --no-color "$_KeyVarName [$(basename $_Keychain)]")" $plblue
            _t4dPromptDiff "$_Current" "$(echo $_Arg | sort -n)"
            _t4dPromptSquare "This is a dry-run, please add -f to apply changes" $plyellow
        else
            _t4dPromptSquare "Current Keychain and New keychain are identical" $plgreen
        fi
    fi

###############################
}