_t4dSrcYalmOpenFile(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmOpenFile
#   - Name:
#       _t4dSrcYalmOpenFile
###
#   - Synopsis:
#       convert current file in .in file ready to be edited
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _File="$1"
    local _Filename="$(basename $1)"
	local _InPutFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_Filename.in"
    _t4dDebugLog $plog "Generating $_InPutFile"
	_t4dSrcYalmParseFile $_File $_InPutFile

###############################
}

_t4dSrcYalmCloseFile(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmCloseFile
#   - Name:
#       _t4dSrcYalmCloseFile
###
#   - Synopsis:
#       read .in file to convert it into .yml file
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _File="$1"
    local _Filename="$(basename $1)"
	local _InPutFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_Filename.in"
    local _outPutFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_Filename.out"
    _t4dDebugLog $plog "Saving $_outPutFile"
	_t4dSrcYalmParseFileRevert $_InPutFile $_outPutFile
	mv $_outPutFile $_File
    rm $_InPutFile

###############################
}