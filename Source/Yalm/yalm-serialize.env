
_t4dSrcYalmSerialize(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmSerialize
#   - Name:
#       _t4dSrcYalmSerialize
###
#   - Synopsis:
#       serialize content to replace any special char
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########

    local _t4dErrorCode=1
    local _ApplyPathSerialize="false"
    if [[ "$1" == "-path" ]]; then
        _ApplyPathSerialize="false"
        shift
    fi
    local _res=$(echo $1 | sed 's|@|§AROBASE§|g' | sed 's|±|§MPLUS§|g' | sed 's|+|§PLUS§|g' | sed 's|:|§DASH§|g' | sed 's/|/§PIPE§/g' | sed 's|"|§DQUOTE§|g' | sed 's| |§SPACE§|g')
    if [[ "$_ApplyPathSerialize" == "true" ]]; then
        echo $_res | sed 's|\.|§DOT§|g' | sed 's|>|§LTHAN§|g' | sed "s|'|§SQUOTE§|g"
    else
        echo $_res
    fi
    

###############################
}

_t4dSrcYalmDeSerialize(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmDeSerialize
#   - Name:
#       _t4dSrcYalmDeSerialize
###
#   - Synopsis:
#       deserialize content to restore all special char
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    echo $1 | sed 's|§DOT§|.|g' | sed 's|§LTHAN§|>|g' | sed 's|§AROBASE§|@|g' | sed 's|§MPLUS§|±|g' | sed 's|§PLUS§|+|g' | sed 's|§DASH§|:|g' | sed 's/§PIPE§/|/g' | sed "s|§SQUOTE§|'|g" | sed 's|§DQUOTE§|"|g'  | sed 's|§SPACE§| |g' | sed 's|§LIST§|- |g' | sed 's|§KEY§||g'
###############################
}

_t4dSrcYalmPathSerialize(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmPathSerialize
#   - Name:
#       _t4dSrcYalmPathSerialize
###
#   - Synopsis:
#       serialize path to be usable
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    _t4dSrcYalmSerialize -path "$1" | sed "s| |§SPACE§|g" | sed 's|\\\.|§DOT§|g' | sed 's|\\>|§LTHAN§|g' | sed 's|\[|~|'g | sed 's|\]|~|'g
}
