
_t4dSrcYalmSerialize(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmSerialize
#   - Name:
#       _t4dSrcYalmSerialize
###
#   - Synopsis:
#       serialize content to replace any special char
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    echo $1 | sed 's|\.|§dot§|g' | sed 's|@|§AROBASE§|g' | sed 's|±|§MPLUS§|g' | sed 's|+|§PLUS§|g' | sed 's|:|§DASH§|g' | sed 's/|/§PIPE§/g' | sed "s|'|§SQUOTE§|g" | sed 's|"|§DQUOTE§|g' | sed 's| |§SPACE§|g'
###############################
}

_t4dSrcYalmDeSerialize(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmDeSerialize
#   - Name:
#       _t4dSrcYalmDeSerialize
###
#   - Synopsis:
#       deserialize content to restore all special char
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    echo $1 | sed 's|§dot§|.|g' | sed 's|§AROBASE§|@|g' | sed 's|§MPLUS§|±|g' | sed 's|§PLUS§|+|g' | sed 's|§DASH§|:|g' | sed 's/§PIPE§/|/g' | sed "s|§SQUOTE§|'|g" | sed 's|§DQUOTE§|"|g'  | sed 's|§SPACE§| |g' | sed 's|§LIST§|- |g' | sed 's|§KEY§||g'
###############################
}
