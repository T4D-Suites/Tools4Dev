SDBtest(){
    _t4dSrcYalmParseFile test.yml
    _t4dSrcYalmParseFileRevert test.yml
    cp -f test.yml.out test.yml
}

_t4dSrcYalmParseClean(){
    local _File="$1"
    local _Folder="$(dirname $_File)"

    mkdir -p "$_Folder"

    if [[ -e "$_File" ]]; then
        rm $_File
    fi
}

_t4dSrcYalmParseFile(){
    local _t4dErrorCode=1
    local _File="$1"
    local _SpaceDelim="±"
    local _IndentTab="$_SpaceDelim$_SpaceDelim"
    local _Delim="§"
    local _Content="$(cat $_File | sed 's|^|§START§|g' | sed 's|$|§END§|g')"
    local _OutPutParsedFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_File.out"
    local _InPutParsedFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_File.in"

    _t4dSrcYalmParseClean $_InPutParsedFile
    _t4dSrcYalmParseClean $_OutPutParsedFile
    local _OldIndent=0
    local _Indent=0
    for _line in $(echo $_Content | sed "s| |$_SpaceDelim|g"); do
        
        local _ParsedLine="$(_t4dSrcYalmParseLine "$(echo $_line | sed "s|$_SpaceDelim| |g" | sed 's|§START§||g' | sed 's|§END§||g' )" | tee -a $_InPutParsedFile)"
        local _Type="$(echo $_ParsedLine | cut -d '|' -f2)"
        local _Key="$(echo $_ParsedLine | cut -d '|' -f3)"
        local _KeyDelim="$(echo $_ParsedLine | cut -d '|' -f4)"
        local _Data="$(echo $_ParsedLine | cut -d '|' -f5 )"
        local _Path="$(echo $_ParsedLine | cut -d '|' -f6 )"

        
        # _t4dDebugLog $plog "$(_t4dSrcYalmDeSerialize $_Path)"

        case $(echo $_Type | sed 's|§||g') in
            COMMENT|NONE|OTHER)
                _Res="${_Data}"
                # _t4dDebugLog $plog "$(_t4dSrcYalmDeSerialize ${_Data})"
            ;;
            *)

                _OldIndent="$_Indent"
                _Indent="$(echo $_ParsedLine | cut -d '|' -f1)"
                
                
                local _AbsolutePath=""
                if [[ $_OldIndent -gt $_Indent ]]; then
                    # _t4dDebugLog $pinfo "Cleaning from $_Indent to $_OldIndent"
                    for _toClean in $(seq $_Indent $_OldIndent); do
                        local _Prefix_$_toClean=""
                    done
                fi

                local _Prefix_$_Indent="$_Path"
                
                for _counter in $(seq 0 $_Indent); do
                    _AbsolutePath="${_AbsolutePath}$(_t4dVarGetValue _Prefix_$_counter)"
                done

                

                if [[ "$_Data" != "" ]]; then
                    # _t4dDebugLog $plog "$(_t4dPromptVarWithChar 120 "$(_t4dSrcYalmDeSerialize $_AbsolutePath | sed 's|%|§PERCENTAGE§|g')" ' ' | sed 's|%||g' | sed 's|§PERCENTAGE§|%|g') >$(_t4dSrcYalmDeSerialize $_Data)<"
                    _Data=" $_Data"
                else
                    # _t4dDebugLog $plog "$(_t4dSrcYalmDeSerialize $_AbsolutePath)"
                fi
                if [[ $_Indent -gt 0 ]]; then
                    _Res="$(_t4dPromptVarWithSpace "$_Indent" "" | sed 's|%||g')${_Type}${_Key}${_KeyDelim}${_Data}"
                else
                    _Res="${_Type}${_Key}${_KeyDelim}${_Data}"
                fi
            ;;
        esac

        _t4dSrcYalmDeSerialize $_Res >> $_OutPutParsedFile
        # local _Data=""
        # local _Delim="@DELIM@"
        # if [[ "$_Head" != "" ]]; then
        #     # _t4dDebugLog $plog "$_Head"
        #     _Data="$(echo $_line | sed "s|${_Head}||g")"
        #     local _Sep="$(echo $_Data | grep '§DASH§')"
        #     _Data="$(echo $_Data | sed 's|^§DASH§||g')"
        # else
        #     _Head="$(echo $_line)"
        # fi

        # if [[ "$_Sep" != "" ]]; then
        #     _Delim="@DELIMDASH@"
        # fi
        # _t4dDebugLog $plog "$_Head - $_Data"

        # local _Comment="$(echo $_Head | grep '^@START@#')"
        # local _Tiret="$(echo $_Head | grep "@START@${_SpaceDelim}*-$_SpaceDelim")"
        # local _EmptyLine="$(echo $_Head | sed "s|$_SpaceDelim||g" )"

        # if [[ "$_Comment" != "" ]]; then
        #     # _t4dDebugLog $plog "Comment"
        #     _Type="NONE"
        # elif [[ "$_Head" == "@START@@END@" ]]; then
        #     #  _t4dDebugLog $plog "Empty"
        #     _Type="@EMPTY@"
        # elif [[ "$_Tiret" != "" ]]; then
        #     #  _t4dDebugLog $plog "Tiret"
        #     _Head="$(echo $_Head | sed "s|-$_SpaceDelim||g")"
        #     local _IndentCount="$(echo $_Head | sed 's|@START@||g' | sed "s|$_IndentTab|\n$_IndentTab|g" | grep "^$_IndentTab" | wc -l | sed 's| ||g')"
        #     _Type=">"
        # else
        #     #  _t4dDebugLog $plog "Dot"
        #     _Type="."
        #     local _IndentCount="$(echo $_Head | sed 's|@START@||g' | sed "s|$_IndentTab|\n$_IndentTab|g" | grep "^$_IndentTab" | wc -l | sed 's| ||g')"
        # fi
        

        # local _HeadTitle="$(echo $_Head | sed "s|^$_IndentTab*||g" | sed "s|$_SpaceDelim||g"  | sed 's|@START@||g' | sed 's|@END@||g' )"
        
        # if [[ "$_Type" == "." ]] || [[ "$_Type" == ">" ]]; then
        #     local _Head_$_IndentCount="${_Type}$_HeadTitle"
        # fi
         
        # for _counter in $(seq 0 4); do
        #     _t4dDebugLog $plog "_Head_$_counter - $(_t4dVarGetValue _Head_$_counter)"
        #     # _prefix="${_prefix}$(_t4dVarGetValue _Head_$_counter)"
        # done
        
        # local _prefix=""
        # if [[ $_IndentCount -gt 0 ]]; then
        #     # _t4dDebugLog $plog "_Head_$_IndentCount -> $(_t4dVarGetValue _Head_$_IndentCount)"
        #     for _counter in $(seq 0 $(expr $_IndentCount - 1)); do
        #         # _t4dDebugLog $plog "_Head_$_counter - $(_t4dVarGetValue _Head_$_counter)"
        #         _prefix="${_prefix}$(_t4dVarGetValue _Head_$_counter)"
        #     done
        #     _t4dDebugLog $pinfo "$_prefix"
        # fi
        # _t4dPromptAskForChar "Test"

        # _HeadTitle="$(echo $_HeadTitle | sed 's|@END@||g')"
        # _Data="$(echo $_Data | sed 's|@END@||g' )"
        # # _t4dDebugLog $plog "$_prefix"
        # if [[ "${_prefix}${_Type}${_HeadTitle}" != "@EMPTY@" ]]; then
        #     local _Key="@KEY-${_IndentCount}@"
        #     local _KeyPath="${_prefix}"
        #     local _KeyType="@TYPE-$(echo $_Type | sed 's|>|LIST|g' | sed 's|\.|DEFAULT|g')@"
        #     local _KeyValue="${_HeadTitle}"
        #     echo "$(_t4dPromptVarWithSpace 9 "$_Key")$(_t4dPromptVarWithSpace 60 "$_KeyPath")$(_t4dPromptVarWithSpace 30 "$_KeyType")$(_t4dPromptVarWithSpace 30 "$_KeyValue")${_Delim}@DATA@${_Data}" >> $_OutPutParsedFile
        # else
        #     echo "@EMPTY@" >> $_OutPutParsedFile
        # fi
    done
}

