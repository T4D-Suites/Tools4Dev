_t4dSrcYalmParseFileRevert(){
    local _File="$1"
    local _SpaceDelim="±"
    
    local _InputParsedFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_File.in"
    local _OutPutParsedFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_File.out"
    local _Content="$(cat $_InputParsedFile | sed 's| *||g')"

    _t4dSrcYalmParseClean $_OutPutParsedFile

    for _line in $(echo $_Content); do
        if [[ "$(echo $_line | grep '@EMPTY@')" != "" ]]; then
            echo "" >> $_OutPutParsedFile
        else
            # _t4dDebugLog $plog "$_line"
            _IndentCount="$(echo $_line | grep -Eo "^@KEY-.*" | cut -d '@' -f2 | sed 's|KEY-||g')"
            _Head="$(echo $_line | grep -Eo "@TYPE-.*" | cut -d '@' -f3 )"
            # _t4dDebugLog $plog "$_Head"
            _Type="$(echo $_line | grep -Eo "@TYPE-.*" | cut -d '@' -f2 | sed s'|TYPE-DEFAULT||g' | sed s'|TYPE-LIST|- |g' | sed 's|TYPE-NONE||g' )"
            _Delim="$(echo $_line | grep -Eo "@DELIM.*" | cut -d '@' -f2 | sed s'|DELIMDASH|:|g' | sed s'|DELIM||g')"
            _Data="$(echo $_line | grep -Eo "@DATA.*" | cut -d '@' -f3 )"

            local _Res=""
            if [[ $_IndentCount -gt 0 ]]; then
                _Res="$(_t4dPromptVarWithSpace $(expr $_IndentCount + $_IndentCount) "" | sed 's|%||g')${_Type}${_Head}${_Delim}${_Data}"
            else
                _Res="${_Type}${_Head}${_Delim}${_Data}"
            fi
            _t4dSrcYalmSerialize -out -input "$_Res" >> $_OutPutParsedFile
        fi
    done
    
}

