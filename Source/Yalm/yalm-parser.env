_t4dSrcYalmSerialize(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmSerialize
#   - Name:
#       _t4dSrcYalmSerialize
###
#   - Synopsis:
#       Serialize file to handle parsing properly
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Type="in"
    local _File=""
    local _Content=""

    while [[ "$@" != "" ]]; do
        case "$1" in
            -out)
                _Type="out"
            ;;
            -file)
                _File="$2"
                shift
            ;;
            -input)
                _Content="$2"
                shift
            ;;
            *)
                _t4dDebugLog $perror "Empty or Unknown argument < $1 >"
                return $_t4dErrorCode
            ;;
        esac
        shift
    done

    if [[ "$_File" != "" ]] && [[ -e "$_File" ]]; then
        _Content="$(cat $_File)"
    fi

    if [[ "$_Content" == "" ]]; then
        _t4dDebugLog $perror "Could not serialize, please use -input or -file or see documentation"
        return $_t4dErrorCode
    fi


    case $_Type in 
        out)
            echo $_Content | sed "s|$_SpaceDelim| |g" | sed 's|^±*||g' | sed 's|@dot@|.|g' | sed 's|§PLUS§|±|g' | sed 's|§DASH§|:|g' | sed 's/§PIPE§/|/g' | sed 's|§AROBASE§|@|g'
        ;;
        *)
            echo $_Content | sed 's|@|§AROBASE§|g' | sed 's|±|§PLUS§|g' | sed 's|:|§DASH§|g' | sed 's/|/§PIPE§/g' | sed 's|^|@START@|g' | sed 's|$|@END@|g'
        ;;
    esac
    

###############################
}

SDBtest(){
    _t4dSrcYalmParseFile test.yml
    _t4dSrcYalmParseFileRevert test.yml
    cp -f test.yml.out test.yml
}

_t4dSrcYalmParseClean(){
    local _File="$1"
    local _Folder="$(dirname $_File)"

    mkdir -p "$_Folder"

    if [[ -e "$_OutPutParsedFile" ]]; then
        rm $_OutPutParsedFile
    fi
}

_t4dSrcYalmParseFile(){
    local _t4dErrorCode=1
    local _File="$1"
    local _SpaceDelim="±"
    local _IndentTab="$_SpaceDelim$_SpaceDelim"
    local _Delim="§"
    local _Content="$(_t4dSrcYalmSerialize -file $_File)"
    local _OutPutParsedFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_File.in"

    _t4dSrcYalmParseClean $_OutPutParsedFile

    for _line in $(echo $_Content | sed "s| |$_SpaceDelim|g"); do
        local _Head="$(echo $_line | cut -d ':' -f1 )"
        
        local _Data=""
        local _Delim="@DELIM@"
        if [[ "$_Head" != "" ]]; then
            # _t4dDebugLog $plog "$_Head"
            _Data="$(echo $_line | sed "s|${_Head}||g")"
            local _Sep="$(echo $_Data | grep ':')"
            _Data="$(echo $_Data | sed 's|^:||g')"
        fi

        if [[ "$_Sep" != "" ]]; then
            _Delim="@DELIMDASH@"
        fi

        local _Comment="$(echo $_HeadTitle | grep '^@START@#')"
        local _Tiret="$(echo $_Head | grep "@START@${_SpaceDelim}*-$_SpaceDelim")"
        local _EmptyLine="$(echo $_Head | sed "s|$_SpaceDelim*||g" )"
        if [[ "$_Comment" != "" ]]; then
            _Type="NONE"
        elif [[ "$_HeadTitle" == "@START@@END@" ]]; then
            _Type="@EMPTY@"
        elif [[ "$_Tiret" != "" ]]; then
            _Head="$(echo $_Head | sed "s|\-$_SpaceDelim||g")"
            local _IndentCount="$(echo $_Head | sed 's|@START@||g' | sed "s|$_IndentTab|\n$_IndentTab|g" | grep "^$_IndentTab" | wc -l | sed 's| ||g')"
            _Type=">"
        else
            _Type="."
        fi


        local _HeadTitle="$(echo $_Head | sed "s|^$_IndentTab*||g" | sed 's|@START@||g' | sed 's|@END@||g' )"
        
        if [[ "$_Type" == "\." ]] || [[ "$_Type" == ">" ]]; then
            local _Head_$_IndentCount="${_Type}$_HeadTitle"
        fi
        #  _t4dDebugLog $plog "_Head_$_IndentCount -> $(_t4dVarGetValue _Head_$_IndentCount)"

        local _prefix=""
        if [[ $_IndentCount -gt 0 ]]; then
            for _counter in $(seq 0 $(expr $_IndentCount - 1)); do
                # _t4dDebugLog $plog "_Head_$_counter - $(_t4dVarGetValue _Head_$_counter)"
                _prefix="${_prefix}$(_t4dVarGetValue _Head_$_counter)"
            done
        fi

        _HeadTitle="$(echo $_HeadTitle | sed 's|@END@||g')"
        _Data="$(echo $_Data | sed 's|@END@||g' )"
        # _t4dDebugLog $plog "$_prefix"
        if [[ "${_prefix}${_Type}${_HeadTitle}" != "@EMPTY@" ]]; then
            local _Key="@KEY-${_IndentCount}@"
            local _KeyPath="${_prefix}"
            local _KeyType="@TYPE-$(echo $_Type | sed 's|>|LIST|g' | sed 's|\.|DEFAULT|g')@"
            local _KeyValue="${_HeadTitle}"
            echo "$(_t4dPromptVarWithSpace 9 "$_Key")$(_t4dPromptVarWithSpace 100 "$_KeyPath")$(_t4dPromptVarWithSpace 30 "$_KeyType")$(_t4dPromptVarWithSpace 30 "$_KeyValue")${_Delim}@DATA@${_Data}" >> $_OutPutParsedFile
        else
            echo "@EMPTY@" >> $_OutPutParsedFile
        fi
    done
}

_t4dSrcYalmParseFileRevert(){
    local _File="$1"
    local _SpaceDelim="±"
    
    local _InputParsedFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_File.in"
    local _OutPutParsedFile="$T4D_PROJECT_LOG_PATH/yalm/_t4dSrcYalmParseFile-$_File.out"
    local _Content="$(cat $_InputParsedFile | sed 's| *||g')"

    _t4dSrcYalmParseClean $_OutPutParsedFile

    for _line in $(echo $_Content); do
        if [[ "$(echo $_line | grep '@EMPTY@')" != "" ]]; then
            echo "" >> $_OutPutParsedFile
        else
            # _t4dDebugLog $plog "$_line"
            _IndentCount="$(echo $_line | grep -Eo "^@KEY-.*" | cut -d '@' -f2 | sed 's|KEY-||g')"
            _Head="$(echo $_line | grep -Eo "@TYPE-.*" | cut -d '@' -f3 )"
            # _t4dDebugLog $plog "$_Head"
            _Type="$(echo $_line | grep -Eo "@TYPE-.*" | cut -d '@' -f2 | sed s'|TYPE-DEFAULT||g' | sed s'|TYPE-LIST|- |g' | sed 's|TYPE-NONE||g' )"
            _Delim="$(echo $_line | grep -Eo "@DELIM.*" | cut -d '@' -f2 | sed s'|DELIMDASH|:|g' | sed s'|DELIM||g')"
            _Data="$(echo $_line | grep -Eo "@DATA.*" | cut -d '@' -f3 )"

            local _Res=""
            if [[ $_IndentCount -gt 0 ]]; then
                _Res="$(_t4dPromptVarWithSpace $(expr $_IndentCount + $_IndentCount) "" | sed 's|%||g')${_Type}${_Head}${_Delim}${_Data}"
            else
                _Res="${_Type}${_Head}${_Delim}${_Data}"
            fi
            _t4dSrcYalmSerialize -out -input "$_Res" >> $_OutPutParsedFile
        fi
    done
    
}

