_t4dSrcYalmLinter(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcYalmLinter
#   - Name:
#       _t4dSrcYalmLinter
###
#   - Synopsis:
#       Linter that allow user to convert yalm file into parsed content and re-convert this into yml content to fix any wrong space
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _File="$1"
    _t4dSrcYalmOpenFile $_File
    _t4dSrcYalmCloseFile $_File

###############################
}

