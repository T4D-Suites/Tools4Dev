_t4dSrcAnsibleInventoryAdd(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryAdd
#   - Name:
#       _t4dSrcAnsibleInventoryAdd
###
#   - Synopsis:
#       add host in Ansible Inventory
###
#   - Usage:
#        _t4dSrcAnsibleInventoryAdd <file> <group> <host>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Path="$1"
    local _Group="$2"
    local _Host="$3"

    if [[ "$_t4dSrcAnsibleInventoryCheck $_Path $_Group $_Host" == "false" ]]; then
        _t4dDebugLog $perror "host already in this group"
        return $_t4dErrorCode
    fi

    if [[ "$_t4dSrcAnsibleInventoryGroupCheck $_Path $_Group" == "false" ]]; then
        echo "\n[$_Group]" >> "$_Path"
    fi

    local _res=$(sed "s|\(.*$(echo $_Group).*\)|\1\n$(echo $_Host)|g" "$_Path")
    echo "$_res" > "$_Path"

###############################
}

_t4dSrcAnsibleInventoryGroupCheck(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryGroupCheck
#   - Name:
#       _t4dSrcAnsibleInventoryGroupCheck
###
#   - Synopsis:
#       ckeck if host group exist
###
#   - Usage:
#        _t4dSrcAnsibleInventoryGroupCheck <file> <group>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _File="$1"
    local _Group="$2"

    local _groups=$(grep -e '^\[' $_File)

    if [[ "$(echo "$_groups" | grep "$_Group")" != "" ]]; then
        echo "false"
    else
        echo "true"
    fi

###############################
}

_t4dSrcAnsibleInventoryCheck(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryCheck
#   - Name:
#       _t4dSrcAnsibleInventoryCheck
###
#   - Synopsis:
#       check is host is already in group
###
#   - Usage:
#        _t4dSrcAnsibleInventoryCheck <file> <group> <host>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Group="$2"
    local _host="$3"
    local _File="$1"

    local _HostInGroup=$(cat $_File | grep -A 1000 "$_Group" | grep -v "$_Group" | grep -m1 -B 1000 "^\[" | grep -v "^\["| sed '/^$/d')

    if [[ "$(grep -w  "$_Host" "$_HostInGroup")"  != "" ]];then
        echo "false"
    else
        echo "true"
    fi

###############################
}      

_t4dSrcAnsibleInventoryFind(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventoryFind
#   - Name:
#       _t4dSrcAnsibleInventoryFind
###
#   - Synopsis:
#       find in inventory
###
#   - Usage:
#        _t4dSrcAnsibleInventoryFind <file> <host>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1

    local _File="$1"
    local _Host="$2"

    local _lines=$(cat "$_File" | tr '\n' ' ' | tr '[' '\n' | tr ']' '=' | grep  $_Host)


    echo $_lines | while read -r line
    do
        local _group=$(echo "$line" | cut -d '=' -f1)
        _t4dPromptSquare "$_group" $plblue
        local _grouphosts=$(echo "$line" | cut -d '=' -f2 | tr ' ' '\n' | grep $_Host)
        echo $_grouphosts

    done

###############################
}      