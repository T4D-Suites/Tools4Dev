source $T4D_SOURCE_PATH/Ansible/ansible-inventory.env


_t4dSrcAnsibleInventory(){
# Generated From $Tools4Dev_PATH/Engine/G4d/templates.env
# v1.8.0
###### _t4dSrcAnsibleInventory
#   - Name:
#       _t4dSrcAnsibleInventory
###
#   - Synopsis:
#       add host and find in Ansible Inventory
###
#   - Usage:
#        _t4dSrcAnsibleInmventoryAddHost <add|find|delete> <file> [groupe] <host>
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Action="$1"
    local _Path="$2"
    local _Group="$3"
    local _Host="$4"

    if [[ "$_Group" == "" ]]; then
        if [[ "$_Action" == add ]] || [[ "$_Action" == delete ]];then
            _t4dDebugLog $perror "empty Group"
            return $_t4dErrorCode
        fi
    fi
    if [[ "$_Host" == "" ]]; then
        if [[ "$_Action" != find ]];then
            _t4dDebugLog $perror "empty Host"
            return $_t4dErrorCode
        fi 
    fi
    if [[ "$_Path" == "" ]]; then
        _t4dDebugLog $perror "empty file"
        return $_t4dErrorCode
    fi


    case "$_Action" in
        add|a)
            _t4dSrcAnsibleInventoryAdd $_Path $_Group $_Host
        ;;
        find|f)
            _t4dSrcAnsibleInventoryFind $_Path $_Group
        ;;
        delete|d)
            _t4dSrcAnsibleInventoryDelete $_Path $_Group $_Host
        ;;
        *)
            _t4dDebugLog $perror "Empty or Unknown action < $_Action >"
            return $_t4dErrorCode
        ;;
    esac

###############################
}