_t4dSrcAndroidListConnectedDevices(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcAndroidListDevices
#   - Name:
#       _t4dSrcAndroidListDevices
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    adb devices | grep -v "List of devices attached" | grep 'device$' | grep "^." | tr '\t' ' ' | cut -d ' ' -f1

###############################
}

_t4dSrcAndroidEmulatorBoot(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcAndroidEmulatorBoot
#   - Name:
#       _t4dSrcAndroidEmulatorBoot
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Device="$1"
    local _Avd="$(_t4dSrcAndroidEmulatorList "$_Device" | head -1)"
    
    if [[ "$_Device" != "" ]] && [[ "$_Avd" != "" ]]; then
        _t4dDebugLog $plog "Starting ${_Avd}"
        ${_AndroidHome}/emulator/emulator -avd ${_Avd}
    else
        _t4dDebugLog $pwarning "Device >$_Device< or _Avd >$_Avd< is empty"
    fi
    

###############################
}

_t4dSrcAndroidEmulatorList(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcAndroidEmulatorList
#   - Name:
#       _t4dSrcAndroidEmulatorList
###
#   - Synopsis:
#       list available emulators from android sdk path, usually ANDROID_HOME or opt folder
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Device="$1"
    
    local _AndroidHome=${ANDROID_HOME:-/opt/google/android-sdk}
    if [[ -e "${_AndroidHome}/emulator/emulator" ]]; then
        ${_AndroidHome}/emulator/emulator -list-avds | grep -v '^INFO' | grep "$_Device"
    else
        _t4dDebugLog $perror "No executable emulator found in >$_AndroidHome<"
        return $_t4dErrorCode
    fi
    

###############################
}

_t4dSrcAndroidWaitForDevice(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcAndroidWaitForDevice
#   - Name:
#       _t4dSrcAndroidWaitForDevice
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _time=0
    local _WaitFor="${1:-60}"
     while true; do
        local _time="$(_t4dMath ${_time} + 1)"
        if [[ "$(_t4dSrcAndroidListConnectedDevices)" != "" ]]; then
            _t4dCheckSucceeded "$(_t4dSrcAndroidListConnectedDevices | head -1) found"
            break
        else
            _t4dPromptInProgress "Wait for connected android device/emulator $(_t4dPromptVarFillWithChar "." "$_time")"
        fi
        sleep 5
        if [[ $_time -gt $_WaitFor ]]; then
            _t4dCheckFailed "No device found"
            break
        fi
    done
    

###############################
}