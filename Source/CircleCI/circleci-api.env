

_t4dSrcCircleCiApiAuth(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcCircleCiApiAuth
#   - Name:
#       _t4dSrcCircleCiApiAuth
###
#   - Synopsis:
#       circleci Auth API call
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _File=${1:-tmp.json}
    (curl   -s --location 'https://circleci.com/api/v2/me' \
            --header "Circle-Token: ${T4D_CCI_API_KEY}" | _t4dConvertToJson "${_File}") || _t4dDebugLog $perror "_t4dSrcCircleCiApiAuth $@ something went wrong"
    if [[ "$_File" == "tmp.json" ]]; then
        _t4dGetJsonData "tmp.json" "."
    fi
###############################
}


_t4dSrcCircleCiApiTriggerPipeline(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcCircleCiApiTriggerPipeline
#   - Name:
#       _t4dSrcCircleCiApiTriggerPipeline
###
#   - Synopsis:
#       trigger specified pipeline in project
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _Project="${1:-gh/CircleCI-Public/api-preview-docs}"
    local _Data="${2:-$(_t4dSrcCircleCiPipelineDefaultJson)}"
    curl    --location "https://circleci.com/api/v2/project/${_Project}/pipeline" \
            --header "Circle-Token: ${T4D_CCI_API_KEY}" \
            --header 'x-attribution-login: tempor voluptate non' \
            --header 'x-attribution-actor-id: tempor voluptate non' \
            --header 'Content-Type: application/json' \
            --data "$_Data"

###############################
}

