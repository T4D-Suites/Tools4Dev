_t4dSrcCircleCiPipelineParseJson(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcCircleCiPipelineParseJson
#   - Name:
#       _t4dSrcCircleCiPipelineParseJson
###
#   - Synopsis:
#       return default json struct for circleci pipeline trigger
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    echo '{'
    echo "    \"branch\": \"$1\","
    echo '    "parameters": {'
    echo "        \"$(echo $2 | cut -d '|' -f1)\": $(echo $2 | cut -d '|' -f2)"
    echo '    }'
    echo '}'

###############################
}


_t4dSrcCircleCiPipelineTriggerPipeline(){
# Generated From Tools4Dev_PATH/Engine/G4d/templates-project.env
# v1.8.0
###### _t4dSrcCircleCiPipelineTriggerPipeline
#   - Name:
#       _t4dSrcCircleCiPipelineTriggerPipeline
###
#   - Synopsis:
#       description
###
#   - Note:
#       <Required>
#       [Optionnal]
#       {XXXXXXX}       = Value To Be Changed, if {URL} then replace {URL} with a valid URL
###
###### DOCUMENTATION BLOC #####
########### CODE BLOC #########
    local _t4dErrorCode=1
    local _project="$1"
    local _branch="$2"
    local _parameters="$3"
    local _Json="$(_t4dSrcCircleCiPipelineParseJson $_branch $_parameters)"
    local _OutputJsonFile=${4:-tmp.json}
    local _dirName="$(dirname $_OutputJsonFile)"
    mkdir -p $_dirName
    _t4dSrcCircleCiApiTriggerPipeline "$_project" "$_Json" > $_OutputJsonFile
    if [[ "$_OutputJsonFile" == "tmp.json" ]]; then
        cat $_OutputJsonFile
    else
        local _State="$(_t4dGetJsonData $_OutputJsonFile ".state")"
        case $_State in
            pending)
                local _BuildNumber="$(_t4dGetJsonData $_OutputJsonFile ".number")"
                _t4dPromptSquare "#${_BuildNumber} Started" $plgreen
                if [[ "$WS_CIRCLE_CI_PROJECT_URL" != "" ]]; then
                    _t4dPromptHyperLink "$WS_CIRCLE_CI_PROJECT_URL/$_BuildNumber" "--> $WS_CIRCLE_CI_PROJECT_URL/$_BuildNumber <--"
                fi
            ;;
            *)
                _t4dDebugLog $pwarning "Unknown Status $_State"
                cat $_OutputJsonFile
            ;;
        esac
    fi
    

###############################
}